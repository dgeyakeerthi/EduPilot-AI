# Names only - set real values in your own .env (never commit it)
AUTH_SECRET=
DATABASE_URL=sqlite:///edupilot.db
EDUPILOT_DEMO_MODE=true
AI_API_KEY=
FRONTEND_BASE_URL=http://localhost:8000
ADMIN_EMAILS=
MAX_UPLOAD_MB=20
UPLOAD_DIR=uploads
GEMINI_PRIMARY_MODEL=
GEMINI_LIGHT_MODEL=
GEMINI_REQUEST_LIMIT=50
OLLAMA_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen3:4b
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMBED_MODEL=nomic-embed-text-v2-moe
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
PLAYWRIGHT_HEADLESS=true
PORTALS_FILE=
SCHEDULER_ENABLED=true
REMINDER_INTERVAL_MIN=60
CRAWL_CHECK_MIN=60
CRAWL_DELAY_S=2
CRAWLER_CONTACT=
AI_DAILY_TOKEN_BUDGET=0
EMBED_INDEX_DIR=data/semantic_index
SCHOLARSHIP_ALERT_INTERVAL_MIN=10
# Stage 9 AI provider defaults (override only with supported model IDs)
GEMINI_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_LIGHT_MODEL=gemini-3.1-flash-lite
LOCAL_LLM_MODEL=qwen3:4b
EMBED_MODEL=nomic-embed-text-v2-moe

# Stage 12 security/operations (rate limiting is process-local; use a shared gateway in production)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
EDUPILOT_HTTPS_TERMINATED=false
